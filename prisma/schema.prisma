// BitQube cloud mining — data model.
// Non-custodial: the platform never holds mined coins. Customers buy a share of a shared
// 24-hour rig (a RigDay). During their Slot the rig mines on a pool with the customer's
// address as the worker (or on their own pool), so the pool pays them directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID // payment confirmed, waiting for the worker to book its slots
  QUEUED // slots booked on a shared rig; waiting for the rig or for the first slot
  PROVISIONING // legacy: renting rigs for one order (before shared rigs)
  ACTIVE // a slot has started; mining (or between slots)
  COMPLETED
  PARTIAL // finished, but delivered less than ordered (see deliveredMhHours)
  FAILED // could not provision; needs refund
  REFUNDED
  CANCELLED
}

// Identity verification (Didit). Only the outcome is stored here; documents stay with Didit.
enum KycStatus {
  NONE // never started, or the last attempt was abandoned or expired
  PENDING // started, not finished
  REVIEW // finished, Didit is reviewing it by hand
  APPROVED
  DECLINED
}

enum PaymentMethod {
  STRIPE
  USDT
  BTQ
  MANUAL // confirmed by an admin (bank transfer, test orders, before gateways are live)
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum Provider {
  MRR // MiningRigRentals: one rental per rig
}

enum RigDayStatus {
  OPEN // taking bookings, not rented yet
  RENTING // the worker is renting it on MRR right now
  ACTIVE // rented; slots run one after another, unsold time mines to the house
  ENDED
  FAILED // renting was interrupted; an admin must check MRR before retrying
}

enum SlotStatus {
  BOOKED
  MINING
  DONE
  MISSED // the rig stopped before this slot ran; its minutes are booked again
}

enum RentalStatus {
  REQUESTED
  ACTIVE
  ENDED
  REFUNDED // refunded by MRR (rig under-delivered or support)
  ERROR
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  passwordHash    String
  role            Role            @default(CUSTOMER)
  suspended       Boolean         @default(false)
  btqAddress      String? // legacy default BTQ payout address
  // Last payout address used per coin, e.g. {"RVN": "R…"}; prefilled at checkout.
  payoutAddresses Json            @default("{}")
  // Per-customer markup override (e.g. 2.5 for a long-term buyer); null = global setting.
  priceMultiplier Decimal?        @db.Decimal(8, 4)
  kycStatus       KycStatus       @default(NONE)
  kycSessionId    String? // Didit session of the latest attempt
  kycUpdatedAt    DateTime?
  createdAt       DateTime        @default(now())
  orders          Order[]
  quotes          Quote[]
  pricingChanges  PricingChange[] @relation("PricingChangeTarget")
  sessions        Session[]
  passwordResets  PasswordReset[]
}

// Login sessions. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A coin customers can mine. Each is served by shared rigs of its algorithm rented on
// MRR; `rigMh` is how big one shared rig is, and plans are a share of its day.
model Coin {
  id                String   @id // ticker: BTQ, BTC, RVN…
  name              String
  algo              String // MRR algorithm slug: kawpow, sha256, scrypt…
  unit              String // hashrate unit shown to customers, e.g. "MH/s"
  unitMh            Decimal  @db.Decimal(24, 12) // MH/s in one `unit` (TH/s = 1000000)
  rigMh             Decimal  @db.Decimal(24, 6)
  enabled           Boolean  @default(false)
  sortOrder         Int      @default(0)
  // Where rigs mine. poolUser is a template: {address} = customer's payout address,
  // {worker} = a short order reference.
  poolHost          String?
  poolPort          Int?
  poolUser          String   @default("{address}.{worker}")
  poolPass          String   @default("x")
  // BTQ on pool.bitqube.org: each rig gets the port matching its difficulty (POOL_PORTS).
  portsByDifficulty Boolean  @default(false)
  ownPoolAllowed    Boolean  @default(true) // customers may enter their own pool
  houseAddress      String? // unsold rig time mines here
  mrrProfileId      String? // MRR pool profile for this algorithm, needed to rent
  updatedAt         DateTime @updatedAt
  quotes            Quote[]
  orders            Order[]
  rigDays           RigDay[]
}

// A package: a share of one shared rig's 24 hours, e.g. 10% = 2h24m of the rig per day.
// No price: prices come from a live MRR quote × markup.
model Plan {
  id        String   @id @default(cuid())
  name      String
  sharePct  Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  quotes    Quote[]
}

// A live price shown to a customer, honoured until expiresAt (pricing.QUOTE_TTL_MS).
// Snapshots the MRR cost and the markup so admin changes never alter a shown price.
model Quote {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  planId           String?
  plan             Plan?    @relation(fields: [planId], references: [id])
  coinId           String
  coin             Coin     @relation(fields: [coinId], references: [id])
  sharePct         Decimal  @db.Decimal(5, 2)
  days             Int
  rigMh            Decimal  @db.Decimal(24, 6)
  rigCostUsd       Decimal  @db.Decimal(12, 2) // one rig for 24h at MRR, at quote time
  hashrateMh       Decimal  @db.Decimal(24, 6) // equivalent steady hashrate: rig × share
  hours            Int // equivalent duration: days × 24
  costUsd          Decimal  @db.Decimal(12, 2) // our cost: rig day × share × days
  multiplier       Decimal  @db.Decimal(8, 4)
  multiplierSource String // "user" | "global"
  priceUsd         Decimal  @db.Decimal(12, 2) // what the customer pays
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  order            Order?

  @@index([userId, createdAt])
}

// Audit trail of markup changes, shown in the admin panel. targetUserId null = global.
model PricingChange {
  id           String   @id @default(cuid())
  targetUserId String?
  targetUser   User?    @relation("PricingChangeTarget", fields: [targetUserId], references: [id])
  oldValue     Decimal? @db.Decimal(8, 4)
  newValue     Decimal? @db.Decimal(8, 4) // null = override removed
  changedBy    String // admin user id
  note         String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
}

model Order {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  quoteId          String       @unique
  quote            Quote        @relation(fields: [quoteId], references: [id])
  coinId           String
  coin             Coin         @relation(fields: [coinId], references: [id])
  // Copied from the quote at purchase time.
  sharePct         Decimal      @db.Decimal(5, 2)
  days             Int
  rigMh            Decimal      @db.Decimal(24, 6)
  slotMinutes      Int // rig time owed in total: 1440 × share × days
  hashrateMh       Decimal      @db.Decimal(24, 6)
  hours            Int
  priceUsd         Decimal      @db.Decimal(12, 2)
  quotedCostUsd    Decimal      @db.Decimal(12, 2)
  quotedRigCostUsd Decimal      @db.Decimal(12, 2)
  multiplier       Decimal      @db.Decimal(8, 4)
  payoutAddress    String       @map("btqAddress") // pool worker = payout address
  // The customer's own pool; null = the coin's pool with payoutAddress as the worker.
  poolHost         String?
  poolPort         Int?
  poolUser         String?
  poolPass         String?
  status           OrderStatus  @default(PENDING_PAYMENT)
  // Legacy single-order rentals only; shared rigs keep their cost on RigDay.
  providerCostUsd  Decimal?     @db.Decimal(12, 2)
  deliveredMhHours Decimal?     @db.Decimal(18, 4)
  failureReason    String?
  // Worker lease: a provisioner sets this while it works on the order so two worker
  // processes can never rent rigs for the same order.
  lockedUntil      DateTime?
  startedAt        DateTime?
  endsAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payments         Payment[]
  rentals          Rental[]
  slots            Slot[]
  events           OrderEvent[]

  @@index([status])
  @@index([userId])
}

// One shared rig rented for 24 hours, split into customers' slots. Slots run back to
// back from the moment it is rented; time nobody bought mines to the coin's house address.
model RigDay {
  id            String       @id @default(cuid())
  coinId        String
  coin          Coin         @relation(fields: [coinId], references: [id])
  status        RigDayStatus @default(OPEN)
  rigMh         Decimal      @db.Decimal(24, 6)
  minutes       Int          @default(1440)
  bookedMinutes Int          @default(0)
  // The most the worker may pay for the rig: the highest rig-day cost quoted to any of
  // its customers, plus overfill and slippage.
  maxCostUsd    Decimal      @db.Decimal(12, 2)
  costUsd       Decimal?     @db.Decimal(12, 2)
  forceRent     Boolean      @default(false) // admin: rent now, whatever is booked
  startsAt      DateTime?
  endsAt        DateTime?
  // What the rig is pointed at right now: a slot id, "house", or null before the first switch.
  target        String?
  lockedUntil   DateTime?
  nextAttemptAt DateTime?
  attempts      Int          @default(0)
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  slots         Slot[]
  rentals       Rental[]

  @@index([coinId, status])
}

// A customer's time on a shared rig. An order has one slot per rig day it lands on.
model Slot {
  id               String     @id @default(cuid())
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id])
  rigDayId         String
  rigDay           RigDay     @relation(fields: [rigDayId], references: [id])
  seq              Int // position on the rig day
  minutes          Int
  status           SlotStatus @default(BOOKED)
  startsAt         DateTime? // planned; set once the rig is rented
  endsAt           DateTime?
  startedAt        DateTime? // when the rig was actually pointed at the customer
  endedAt          DateTime?
  deliveredMhHours Decimal?   @db.Decimal(24, 6)
  createdAt        DateTime   @default(now())

  @@unique([rigDayId, seq])
  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amountUsd     Decimal       @db.Decimal(12, 2)
  // Amount in the paid asset (USDT, BTQ) at the quoted rate; null for Stripe.
  amountAsset   Decimal?      @db.Decimal(24, 8)
  rateUsd       Decimal?      @db.Decimal(24, 8)
  providerRef   String?       @unique // Stripe session id, NOWPayments id, or BTQ deposit address
  txid          String? // BTQ: every txid paid to the deposit address, comma-separated
  // BTQ only, updated by the worker from the node: total received at the deposit address
  // (unconfirmed included), confirmations of the newest of those transactions, and when
  // the first one was seen. A payment seen before expiresAt is honoured even if it
  // confirms after it.
  receivedAsset Decimal?      @db.Decimal(24, 8)
  confirmations Int?
  seenAt        DateTime?
  expiresAt     DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
}

// One MRR rental. A shared rig (RigDay) usually is one, sometimes a few rigs together.
model Rental {
  id           String       @id @default(cuid())
  orderId      String? // legacy single-order rentals
  order        Order?       @relation(fields: [orderId], references: [id])
  rigDayId     String?
  rigDay       RigDay?      @relation(fields: [rigDayId], references: [id])
  provider     Provider
  externalId   String // MRR rental id
  rigId        String?
  advertisedMh Decimal      @db.Decimal(24, 6)
  averageMh    Decimal?     @db.Decimal(24, 6)
  costUsd      Decimal      @db.Decimal(12, 2)
  costAsset    Decimal?     @db.Decimal(18, 8) // what was actually debited (BTC on MRR)
  costCurrency String?
  port         Int? // pool port chosen for this rig's difficulty window
  // True while PUT /rental/{id}/pool has not succeeded: the rig is still hashing to the
  // base profile's house worker, and the poller must retry the repoint.
  poolPending  Boolean      @default(false)
  status       RentalStatus @default(REQUESTED)
  startsAt     DateTime?
  endsAt       DateTime?
  lastPolledAt DateTime?
  raw          Json? // last GET /rental/{id} payload, for support/debugging
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([provider, externalId])
  @@index([status])
}

// Append-only audit trail shown to admins (and a filtered view to the customer).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Admin-editable key/value settings: pricing.globalMultiplier, pricing.slippagePct,
// btq.enabled, btq.usdRate, slots.minBookedPct, ...
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// One-time password reset links. Like sessions, only the token's SHA-256 is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Outgoing email queue. Pages and jobs insert rows (in the same transaction as the change
// they announce); the worker sends them over SMTP and retries failures with backoff.
model Email {
  id        String      @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String
  kind      String // template name, e.g. "order.active"
  orderId   String?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sendAfter DateTime    @default(now())
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([status, sendAfter])
  @@index([orderId])
}
