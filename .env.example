DATABASE_URL=postgresql://bitqube:bitqube@localhost:54329/bitqube_cloud

# MiningRigRentals API v2 key (Account > API Keys). Web key: Balance Read, Rentals Write, Rigs Read.
# Never Balance/Withdraw Write.
MRR_API_KEY=
MRR_API_SECRET=
# A SECOND key for the worker process. MRR nonces must increase per key across every
# caller, so the web app and worker can't share one. Same permissions as above.
MRR_WORKER_API_KEY=
MRR_WORKER_API_SECRET=
MRR_MIN_RPI=80

# RentMiningRigs B2B API v1 (https://rentminingrigs.net/developers). Not wired into the app yet.
# RMR_API_SECRET is the "API Secret" from their email; it verifies their webhook signatures.
# RMR_SANDBOX=true sends X-Sandbox: true (fake balance, nothing is rented).
RMR_API_KEY=
RMR_API_SECRET=
RMR_SANDBOX=true
# Balance currency rentals are paid in. The account has paid in ETH so far; many
# rigs only enable BTC and ETH costs ~25% more for the same rig, so BTC is recommended.
MRR_CURRENCY=BTC
# KawPOW profile rentals are created with before being repointed at each slot's pool
# (BTQ and RVN). Other coins set their own profile in Admin -> Coins.
# 985841 = "Default - Last Used" (kawpow, pool.bitqube.org:10032, house worker).
MRR_PROFILE_ID=985841


# Pools are set per coin in Admin -> Coins. For BTQ, rigs are matched to pool.bitqube.org's
# ports by difficulty: port:minDiff:maxDiff per stratum port (from pool_configs/bitqube.json
# varDiff). 10032 suits 20 MH/s-2 GH/s rigs, 10128 rental rigs that need difficulty 0.1-4
# (0.43G-17G hashes), 10256 only very large ones; BTQ rigs whose MRR
# optimal_diff window fits none of these are skipped. See docs/mrr-integration.md.
POOL_PORTS=10032:0.02:16,10128:0.1:4,10256:1000:9000

# ---------------- Email (SMTP) ----------------
# The current values are a TEST mailbox for development; production uses its own
# (see docs/production-checklist.md).
# Google Workspace: SMTP_PASSWORD must be an App Password (Google account > Security >
# 2-Step Verification > App passwords), 16 letters; spaces are fine. Leave blank to keep
# emails queued without sending.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=updates@example.com
SMTP_PASSWORD=
# Display name and address customers see. Gmail only allows the login address or a
# verified alias of it here.
SMTP_FROM="BitQube Cloud Mining <updates@example.com>"
# Public base URL used in email links (and to load the logo in emails).
APP_URL=https://cloud.bitqube.org
# Comma-separated addresses for admin alerts (failed/partial orders). Empty = all admin accounts.
ADMIN_ALERT_EMAIL=

# ---------------- BTQ payments ----------------
# The BitQube node whose wallet issues a fresh deposit address per order (getnewaddress)
# and receives the payments. Reach it over the private network only, never a public URL.
# Leave blank to hide BTQ at checkout. The BTQ price and the confirmations, cap and
# payment-window settings are in Admin > Settings. See docs/btq-payments.md.
BTQ_RPC_URL=
BTQ_RPC_USER=
BTQ_RPC_PASSWORD=
